{
	"servers": {
		"github": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-github"
			],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
			},
			"type": "stdio"
		},
		"describe_react_packages": {
			"command": "node",
			"args": ["./src/mcp/server.js"],
			"type": "stdio"
		}
	},
	"inputs": [
		{
			"type": "promptString",
			"id": "github_token",
			"description": "GitHub personal access token",
			"password": true
		}
	]
}